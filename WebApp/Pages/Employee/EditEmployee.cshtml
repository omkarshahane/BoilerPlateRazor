@page
@model WebApp.Pages.Employee.EditEmployeeModel
@{
    Layout = "~/Pages/Shared/_DesktopLayout.cshtml";
}

<div class="main-content">
    <div class="d-flex flex-column gap-48">
        <header class="header">
            <h1>@Model.FullName </h1>
            <div class="d-flex gap-8 align-items-center">
                <p class="bodySmall">Status</p>
                <a href="javascript:;" class="ec-secondary-btn w-auto">
                    <span class="bodySmallBold text-primary-dark">Active</span>
                </a>
            </div>
        </header>
        <form action="" method="post" class="d-flex flex-column gap-16">
            <input type="hidden" asp-for="Employee.Id" />

            <div class="d-flex gap-48">
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-number" class="text-primary-dark">
                        <span class="bodySmallBold">Employee number </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="1001" -->
                        <input type="text" id="employee-number" asp-for="Employee.EmployeeNumber" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span asp-validation-for="Employee.EmployeeNumber" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-category" class="text-primary-dark">
                        <span class="bodySmallBold">Employee category </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Remove selected attribute and let asp-for handle it -->
                        <select asp-for="Employee.EmployeeCategory" class="body ec-select text-primary-dark" aria-label="Select Category">
                            <option value="">Choose category</option>
                            <option value="engineer">Engineer</option>
                            <option value="admin">Admin</option>
                        </select>
                        <span asp-validation-for="Employee.EmployeeCategory" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-48">
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-firstname" class="text-primary-dark">
                        <span class="bodySmallBold">First name  </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="Suryakant" -->
                        <input type="text" id="employee-firstname" asp-for="Employee.FirstName" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span asp-validation-for="Employee.FirstName" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-lastname" class="text-primary-dark">
                        <span class="bodySmallBold">Last Name </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="Chavan" -->
                        <input type="text" id="employee-lastname" asp-for="Employee.LastName" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span asp-validation-for="Employee.LastName" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-48">
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-email" class="text-primary-dark">
                        <span class="bodySmallBold">Email  </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="suryakant.chavan@iconnectsolutions.com" -->
                        <input type="email" id="employee-email" asp-for="Employee.Email" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span class="text-invalid bodySmallBold" asp-validation-for="Employee.Email"></span>
                    </div>
                </div>
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-contact" class="text-primary-dark">
                        <span class="bodySmallBold">Contact number </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="123456" -->
                        <input type="text" id="employee-contact" asp-for="Employee.ContactNumber" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span asp-validation-for="Employee.ContactNumber" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-48">
                <div class="flex-grow-1 d-flex flex-column gap-8">
                    <label for="employee-home-address" class="text-primary-dark">
                        <span class="bodySmallBold">Home Address  </span>
                        <span class="bodySmall">(required)</span>
                    </label>
                    <div class="d-flex flex-column gap-8">
                        <!-- Removed value="123 High Street, London WC1A 1AB, United Kingdom" -->
                        <input type="text" id="employee-home-address" asp-for="Employee.HomeAddress" class="form-control body padding-trbl-16" aria-required="true" placeholder="" >
                        <span asp-validation-for="Employee.HomeAddress" class="text-invalid bodySmallBold"></span>
                    </div>
                </div>
            </div>

            <div class="form-check form-switch padding-tb-16">
                <label class="form-check-label bodySmall" for="is-escalator-engineer">Is this employee an escalator engineer</label>
                <!-- Removed checked attribute -->
                <input class="form-check-input" asp-for="Employee.IsEscalatorEngineer" type="checkbox" role="switch" id="is-escalator-engineer" aria-label="Is this employee an escalator engineer">
            </div>

            <div class="form-check form-switch padding-tb-16">
                <label class="form-check-label bodySmall" for="is-compressed-or-part-time">Is the employee part-time or on compressed hours?</label>
                <input class="form-check-input" asp-for="Employee.IsPartTimeOrCompressed" type="checkbox" role="switch" id="is-compressed-or-part-time" aria-label="Is the employee part-time">
            </div>

            <div class="d-flex gap-24 padding-tb-48" >
                <a href="javascript:;" class="ec-secondary-btn w-auto" data-action="open-admin-modal">
                    <span class="bodySmallBold text-primary-dark" data-action="editEmployee">Cancel</span>
                </a>
                <button type="submit" class="es-button bodyBold text-white text-decoration-none d-inline-flex">Save changes</button>
            </div>
        </form>
    </div>
</div>

<div class="popup" id="popup">
    <div data-popup="inner">
        <div class="admin-modal d-none" id="keepDiscardChanges">
            <div class="d-flex flex-column gap-48">
                <h2 class="px-4 text-center">Are you sure you want to discard changes?</h2>
                <div class="d-flex gap-24 justify-content-between">
                    <a href="javascript:;" class="ec-secondary-btn" data-action="close-admin-modal">
                        <span class="bodySmallBold text-primary-dark">No, keep editing</span>
                    </a>
                    <button onclick="discardChanges()" type="button" class="es-button bodyBold text-white text-decoration-none d-inline-flex w-159-5">
                        Yes, discard
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/scripts/employee/editemployee.js"></script>